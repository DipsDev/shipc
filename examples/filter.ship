fun filter(arr, cb) {
    let filtered = [];
    for num in arr {
        if cb(num) {
            filtered.push(num);
        }
    }
    return filtered;
}

let my_arr = [10, 30, 50, 70, 30, 10, 20, 15, 19, 13];
let filter_odd = fun(num) {
    return num % 2 == 0;
};

let new_arr = filter(my_arr, filter_odd);
print(new_arr);